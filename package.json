{
  "name": "handdrawn-map-kit",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Standalone hand-drawn illustrated cultural map toolkit (inspired by Aleksandra & Daniel Mizielinski's Maps), extracted from statechart-art's dry-media engine.",
  "main": "src/index.js",
  "scripts": {
    "demo": "node examples/japan_cultural_map.js --fast",
    "demo:hd": "node examples/japan_cultural_map.js",
    "demo:korea": "node examples/korea_cultural_map.js --fast",
    "demo:korea:hd": "node examples/korea_cultural_map.js",
    "build:data": "node scripts/build-natural-earth.js",
    "test": "node --test"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.13"
  }
}
